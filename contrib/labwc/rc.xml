<?xml version="1.0" encoding="UTF-8"?>
<!--
  labwc rc.xml wired for quickshellku.
  Mod key W = Super (same as niri's default Mod).
  App launcher / screenshots / panels are driven through the shell's IPC
  (`qs ipc call ...`); volume uses wpctl (PipeWire); brightness brightnessctl.
  Copy this file (and the siblings) to ~/.config/labwc/.
-->
<labwc_config>
    <core>
        <decoration>server</decoration>
        <gap>4</gap>
        <adaptiveSync>yes</adaptiveSync>
        <reuseOutputMode>yes</reuseOutputMode>
    </core>

    <theme>
        <name>Base16</name>
        <titlebar>
            <layout>menu:iconify,max,close</layout>
            <showTitle>no</showTitle>
        </titlebar>
        <keepBorder>no</keepBorder>
        <cornerRadius>8</cornerRadius>
        <font place="ActiveWindow"><name>SF Pro Text</name><size>11</size><weight>normal</weight></font>
        <font place="InactiveWindow"><name>SF Pro Text</name><size>11</size><weight>normal</weight></font>
        <font place="MenuItem"><name>SF Pro Text</name><size>11</size><weight>normal</weight></font>
        <font place="OnScreenDisplay"><name>SF Pro Text</name><size>12</size><weight>bold</weight></font>
    </theme>

    <windowSwitcher show="yes" preview="yes" outlines="no">
        <fields>
            <field content="type" width="20%" />
            <field content="identifier" width="40%" />
            <field content="title" width="40%" />
        </fields>
    </windowSwitcher>

    <resistance><screenEdgeStrength>20</screenEdgeStrength></resistance>
    <resize popupShow="Never" />

    <focus>
        <followMouse>no</followMouse>
        <raiseOnFocus>yes</raiseOnFocus>
    </focus>

    <snapping>
        <range>5</range>
        <topMaximize>yes</topMaximize>
        <overlay><enabled>yes</enabled><delay><inner>200</inner><outer>200</outer></delay></overlay>
    </snapping>

    <desktops>
        <popupTime>1000</popupTime>
        <number>5</number>
    </desktops>

    <regions>
        <region name="top-left" x="0%" y="0%" height="50%" width="50%" />
        <region name="top" x="0%" y="0%" height="50%" width="100%" />
        <region name="top-right" x="50%" y="0%" height="50%" width="50%" />
        <region name="left" x="0%" y="0%" height="100%" width="50%" />
        <region name="center" x="20%" y="20%" height="60%" width="60%" />
        <region name="right" x="50%" y="0%" height="100%" width="50%" />
        <region name="bottom-left" x="0%" y="50%" height="50%" width="50%" />
        <region name="bottom" x="0%" y="50%" height="50%" width="100%" />
        <region name="bottom-right" x="50%" y="50%" height="50%" width="50%" />
    </regions>

    <!-- leave room for the top menu bar (32px) + a little for the dock -->
    <margin top="34" bottom="8" left="8" right="8" />

    <keyboard>
        <default />

        <!-- Workspaces -->
        <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
        <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
        <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
        <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
        <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
        <keybind key="W-C-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
        <keybind key="W-C-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
        <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
        <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
        <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
        <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
        <keybind key="W-S-5"><action name="SendToDesktop" to="5" /></keybind>

        <!-- Window management -->
        <keybind key="W-q"><action name="Close" /></keybind>
        <keybind key="A-F4"><action name="Close" /></keybind>
        <keybind key="W-space"><action name="ToggleMaximize" /></keybind>
        <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
        <keybind key="W-c"><action name="ToggleSnapToRegion" region="center" /></keybind>
        <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
        <keybind key="W-Left"><action name="ToggleSnapToEdge" direction="left" /></keybind>
        <keybind key="W-Right"><action name="ToggleSnapToEdge" direction="right" /></keybind>
        <keybind key="W-Down"><action name="ToggleSnapToEdge" direction="down" /></keybind>
        <keybind key="A-Tab"><action name="NextWindow" /></keybind>

        <!-- Apps / launcher (quickshellku) -->
        <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
        <keybind key="W-d"><action name="Execute" command="qs ipc call launcher toggle" /></keybind>
        <keybind key="W-S-Return"><action name="Execute" command="qs ipc call launcher toggle" /></keybind>
        <keybind key="W-comma"><action name="Execute" command="qs ipc call launcher toggle" /></keybind> <!-- launcher ';' = clipboard -->
        <keybind key="W-e"><action name="Execute" command="pcmanfm" /></keybind>
        <keybind key="W-b"><action name="Execute" command="brave" /></keybind>

        <!-- Shell panels (quickshellku IPC) -->
        <keybind key="W-Escape"><action name="Execute" command="qs ipc call power toggle" /></keybind>
        <keybind key="W-n"><action name="Execute" command="qs ipc call notifications toggle" /></keybind>

        <!-- Screenshots (quickshellku) -->
        <keybind key="Print"><action name="Execute" command="qs ipc call shot full" /></keybind>
        <keybind key="W-Print"><action name="Execute" command="qs ipc call shot region" /></keybind>
        <keybind key="W-S-s"><action name="Execute" command="qs ipc call screenshot toggle" /></keybind>

        <!-- Volume (PipeWire) / brightness — the shell shows the OSD on change -->
        <keybind key="XF86_AudioRaiseVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
        <keybind key="XF86_AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
        <keybind key="XF86_AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
        <keybind key="XF86_AudioMicMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
        <keybind key="XF86_MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
        <keybind key="XF86_MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>

        <!-- Media keys -->
        <keybind key="XF86_AudioPlay"><action name="Execute" command="playerctl play-pause" /></keybind>
        <keybind key="XF86_AudioNext"><action name="Execute" command="playerctl next" /></keybind>
        <keybind key="XF86_AudioPrev"><action name="Execute" command="playerctl previous" /></keybind>

        <!-- Snap to regions (numpad) -->
        <keybind key="W-KP_7"><action name="SnapToRegion" region="top-left" /></keybind>
        <keybind key="W-KP_8"><action name="SnapToRegion" region="top" /></keybind>
        <keybind key="W-KP_9"><action name="SnapToRegion" region="top-right" /></keybind>
        <keybind key="W-KP_4"><action name="SnapToRegion" region="left" /></keybind>
        <keybind key="W-KP_5"><action name="SnapToRegion" region="center" /></keybind>
        <keybind key="W-KP_6"><action name="SnapToRegion" region="right" /></keybind>
        <keybind key="W-KP_1"><action name="SnapToRegion" region="bottom-left" /></keybind>
        <keybind key="W-KP_2"><action name="SnapToRegion" region="bottom" /></keybind>
        <keybind key="W-KP_3"><action name="SnapToRegion" region="bottom-right" /></keybind>

        <!-- Misc -->
        <numlock>on</numlock>
        <keybind key="W-x"><action name="ToggleAlwaysOnTop" /></keybind>
        <keybind key="W-C-Backspace"><action name="Exit" /></keybind>
    </keyboard>

    <mouse>
        <default />
        <doubleClickTime>500</doubleClickTime>

        <context name="Frame">
            <mousebind button="W-Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
            <mousebind button="W-Left" action="Drag"><action name="Move" /></mousebind>
            <mousebind button="W-Right" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
            <mousebind button="W-Right" action="Drag"><action name="Resize" /></mousebind>
        </context>

        <context name="Title">
            <mousebind button="Left" action="Drag"><action name="Move" /></mousebind>
            <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
        </context>
        <context name="TitleBar">
            <mousebind button="Right" action="Click"><action name="ShowMenu" menu="client-menu" /></mousebind>
        </context>
        <context name="Maximize"><mousebind button="Left" action="Click"><action name="ToggleMaximize" /></mousebind></context>
        <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify" /></mousebind></context>
        <context name="Close"><mousebind button="Left" action="Click"><action name="Close" /></mousebind></context>

        <context name="Root">
            <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu" /></mousebind>
            <mousebind direction="Left" action="Scroll"><action name="GoToDesktop" to="left" wrap="yes" /></mousebind>
            <mousebind direction="Right" action="Scroll"><action name="GoToDesktop" to="right" wrap="yes" /></mousebind>
        </context>
    </mouse>

    <libinput>
        <device category="default">
            <naturalScroll>no</naturalScroll>
            <accelProfile>flat</accelProfile>
            <tap>yes</tap>
            <tapAndDrag>yes</tapAndDrag>
            <middleEmulation>yes</middleEmulation>
            <disableWhileTyping>yes</disableWhileTyping>
        </device>
    </libinput>
</labwc_config>
